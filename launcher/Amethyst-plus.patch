@@ -0,0 +1,20 @@
+package io.stamethyst.backend.render
+
+data class CustomGameResolution private constructor(val width: Int, val height: Int) {
+    val portrait: Boolean get() = width < height
+
+    companion object {
+        val DEFAULT = CustomGameResolution(1080, 2340)
+        const val MAX_DIMENSION = 4096
+        private const val MAX_PIXELS = 8_388_608
+
+        fun validate(width: Int?, height: Int?): CustomGameResolution? {
+            if (width == null || height == null) return null
+            if (width !in VirtualResolutionPolicy.MIN_GAME_WIDTH..MAX_DIMENSION ||
+                height !in VirtualResolutionPolicy.MIN_GAME_HEIGHT..MAX_DIMENSION ||
+                width * height > MAX_PIXELS
